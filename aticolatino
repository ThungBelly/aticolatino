<!DOCTYPE html>


.region{margin-left:auto;margin-right:24px}
.region span{background:#7f1d1d;color:#fecaca;font-weight:800;font-size:11px;padding:6px 12px;border-radius:999px}


.tiers{display:flex;flex-wrap:wrap;gap:8px}
.pill{display:flex;flex-direction:column;align-items:center;justify-content:center;width:46px;height:46px;border-radius:999px;background:#020617;border:1px solid #1e293b;font-size:11px;font-weight:900}
.mode-icon{font-size:16px;line-height:1}
.pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:#020617;border:1px solid #1e293b;font-size:12px;font-weight:800}
.mode-icon{width:18px;height:18px;image-rendering:pixelated}
.ht1{color:#22c55e}
.lt1{color:#facc15}
.ht2{color:#a855f7}
.ht3{color:#fb7185}
.lt2{color:#38bdf8}


footer{padding:16px;text-align:center;font-size:12px;color:#64748b}
</style>
</head>
<body>
<header>
<h1>Overall Rankings</h1>
<p>Server IP: mcpvp.club</p>
<div class="tabs">
<div class="tab active" data-mode="overall">Overall</div>
<div class="tab" data-mode="classic">Classic</div>
<div class="tab" data-mode="uhc">UHC</div>
<div class="tab" data-mode="bedfight">Bedfight</div>
<div class="tab" data-mode="gapple">Gapple</div>
<div class="tab" data-mode="soup">Soup</div>
<div class="tab" data-mode="axepvp">AxePvP</div>
<div class="tab" data-mode="nodebuff">NoDebuff</div>
<div class="tab" data-mode="sumo">Sumo</div>
</div>
</header>


<div class="container" id="list"></div>


<footer>© 2026 · MCTiers Style – Overall</footer>


<script>
const modeIcons={
classic:'⚔️',
uhc:'❤️',
bedfight:'🛏️',
gapple:'🍎',
soup:'🍲',
axepvp:'🪓',
nodebuff:'🧪',
sumo:'🪢'
};


const players=[
{name:'ThungBelly',avatar:'ThungBelly',tiers:{classic:'HT1',uhc:'LT1',bedfight:'LT1',gapple:'HT1',soup:'LT1',axepvp:'LT1',nodebuff:'HT1',sumo:'HT1'}},
{name:'22jaze',avatar:'22jaze',tiers:{classic:'LT1',uhc:'HT1',bedfight:'HT1',gapple:'LT1',soup:'HT1',axepvp:'HT1',nodebuff:'LT1',sumo:'LT1'}},
{name:'AbrahamMeloyo_',avatar:'AbrahamMeloyo_',tiers:{classic:'HT2',uhc:'HT2',bedfight:'HT2',gapple:'HT2',soup:'HT2',axepvp:'HT2',nodebuff:'HT2',sumo:'HT2'}},
{name:'Know_exe',avatar:'Know_exe',tiers:{classic:'LT2',uhc:'LT2',bedfight:'HT3',gapple:'LT2',soup:'LT2',axepvp:'HT3',nodebuff:'LT2',sumo:'LT2'}}
];


function tierScore(t){return{HT1:1,LT1:2,HT2:3,LT2:4,HT3:5}[t]||99}


function render(mode){
const box=document.getElementById('list');box.innerHTML='';
let sorted=[...players];
if(mode!=='overall')sorted.sort((a,b)=>tierScore(a.tiers[mode])-tierScore(b.tiers[mode]));
sorted.forEach((p,i)=>{
box.innerHTML+=`<div class="row">
<div class="num">${i+1}</div>
<div class="player">
<div class="avatar"><img src="https://mc-heads.net/avatar/${p.avatar}/64"></div>
<div><div class="player-name">${p.name}</div><div class="subtitle">Combat Grandmaster</div></div>
</div>
<div class="region"><span>NA</span></div>
<div class="tiers">${mode==='overall'?Object.entries(p.tiers).map(([m,t])=>`<div class="pill"><span class="mode-icon">${modeIcons[m]}</span><span class="${t.toLowerCase()}">${t}</span></div>`).join(''):`<div class="pill"><span class="mode-icon">${modeIcons[mode]}</span><span class="${p.tiers[mode].toLowerCase()}">${p.tiers[mode]}</span></div>`}</div>`).join(''):`<div class="pill"><img class="mode-icon" src="${modeIcons[m]||modeIcons[mode]}" alt="mode" /> <span class="${p.tiers[mode].toLowerCase()}">${p.tiers[mode]}</span></div>`}</div>
</div>`;
});
}


render('overall');


document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
t.classList.add('active');render(t.dataset.mode);
});
</script>
</body>
</html>
